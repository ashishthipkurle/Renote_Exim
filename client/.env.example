# Supabase (Auth + Postgres) — REQUIRED
NEXT_PUBLIC_SUPABASE_URL="https://lfdpflbmtbxikncqezff.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-supabase-anon-key>"

# Database — REQUIRED (Supabase Postgres via connection pooler)
DATABASE_URL="postgresql://postgres.lfdpflbmtbxikncqezff:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — REQUIRED for prisma migrate (not pooled)
DIRECT_URL="postgresql://postgres.lfdpflbmtbxikncqezff:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# File Upload (Cloudinary - Optional)
