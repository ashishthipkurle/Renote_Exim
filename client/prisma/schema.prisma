generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(uuid())
  name             String?
  email            String         @unique
  password         String?
  role             Role           @default(IMPORTER)
  companyName      String?
  country          String?
  phone            String?
  website          String?
  businessType     String?
  taxId            String?
  address          String?
  verified         Boolean        @default(false)
  avatar           String?
  twoFactorEnabled Boolean        @default(false)
  twoFactorSecret  String?
  twoFactorBackupCodes String[]   @default([])
  stripeCustomerId String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  businessHours    Json?          @default("{}")
  description      String?
  monthlyBudget    Float           @default(0)
  preferredCategories String[]      @default([])
  socialLinks      Json?          @default("{}")
  documents        Document[]
  receivedMessages Message[]      @relation("Receiver")
  sentMessages     Message[]      @relation("Sender")
  notifications    Notification[]
  orders           Order[]        @relation("ImporterOrders")
  exportedProducts Product[]      @relation("ExporterProducts")
  shipments        Shipment[]
  suppliers        Supplier[]
  wishlist         Wishlist[]
  loginHistory     LoginHistory[]
  addresses        Address[]
  rfqs             RFQ[]          @relation("ImporterRFQs")
  receivedRfqs     RFQ[]          @relation("ExporterRFQs")
  quotes           Quote[]
  reviews          Review[]       @relation("UserReviews")
  givenReviews     Review[]       @relation("GivenReviews")
  emailPreferences Json?          @default("{\"orders\": true, \"security\": true, \"marketing\": false}")
  deletedAt        DateTime?

  @@index([email])
  @@index([role])
  @@map("users")
}

// ... existing models ...

model RFQ {
  id              String      @id @default(uuid())
  title           String
  importerId      String
  exporterId      String?
  category        ProductCategory
  description     String
  quantity        Int
  unit            String
  budget          Float?
  deadline        DateTime?
  status          RFQStatus   @default(OPEN)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  importer        User        @relation("ImporterRFQs", fields: [importerId], references: [id], onDelete: Cascade)
  exporter        User?       @relation("ExporterRFQs", fields: [exporterId], references: [id], onDelete: SetNull)
  quotes          Quote[]
  
  @@index([importerId])
  @@index([exporterId])
  @@index([status])
  @@map("rfqs")
}

model Quote {
  id              String      @id @default(uuid())
  rfqId           String
  exporterId      String
  price           Float
  validUntil      DateTime
  notes           String?
  status          QuoteStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  rfq             RFQ         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  exporter        User        @relation(fields: [exporterId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([exporterId])
  @@map("quotes")
}

model Review {
  id              String      @id @default(uuid())
  userId          String      // The user being reviewed (Exporter or Importer)
  reviewerId      String      // The user giving the review
  rating          Int
  comment         String?
  orderId         String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  reviewer        User        @relation("GivenReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  order           Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([reviewerId])
  @@map("reviews")
}

enum RFQStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_history")
}

model Product {
  id             String          @id @default(uuid())
  exporterId     String
  name           String
  category       ProductCategory
  description    String
  price          Float
  minOrderQty    Int
  unit           String
  originCountry  String
  hsCode         String?
  images         String[]
  certifications String[]
  available      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  quantity       Int             @default(0)
  deletedAt      DateTime?
  orderItems     OrderItem[]
  exporter       User            @relation("ExporterProducts", fields: [exporterId], references: [id], onDelete: Cascade)
  wishlistedBy   Wishlist[]
  priceHistory   PriceHistory[]

  @@index([name])
  @@index([category])
  @@index([exporterId])
  @@map("products")
}

model Order {
  id                    String        @id @default(uuid())
  orderNumber           String        @unique
  importerId            String
  totalPrice            Float
  currency              String        @default("USD")
  status                OrderStatus   @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  notes                 String?
  stripePaymentIntentId String?       @unique
  stripeSessionId       String?       @unique
  shippingAddressId     String?
  billingAddressId      String?
  shippingAddress       Address?      @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress        Address?      @relation("BillingAddress", fields: [billingAddressId], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  messages              Message[]
  importer              User          @relation("ImporterOrders", fields: [importerId], references: [id], onDelete: Cascade)
  items                 OrderItem[]
  shipment              Shipment?
  documents             Document[]
  review                Review?
  deletedAt             DateTime?

  @@index([orderNumber])
  @@index([importerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Address {
  id             String      @id @default(uuid())
  userId         String
  street         String
  city           String
  state          String
  postalCode     String
  country        String
  type           AddressType @default(SHIPPING)
  isDefault      Boolean     @default(false)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[]     @relation("ShippingAddress")
  billingOrders  Order[]     @relation("BillingAddress")

  @@map("addresses")
}

enum AddressType {
  SHIPPING
  BILLING
}

model Shipment {
  id                String         @id @default(uuid())
  orderId           String         @unique
  userId            String
  trackingNumber    String         @unique
  carrier           String
  origin            String
  destination       String
  estimatedDelivery DateTime
  actualDelivery    DateTime?
  status            ShipmentStatus @default(PREPARING)
  currentLocation   String?
  statusHistory     Json[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  orderId    String?
  subject    String?
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Document {
  id          String       @id @default(uuid())
  ownerId     String
  type        DocumentType
  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  verified    Boolean      @default(false)
  verifiedAt  DateTime?
  verifiedBy  String?
  orderId     String?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("documents")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Supplier {
  id            String   @id @default(uuid())
  userId        String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  country       String?
  category      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("suppliers")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String
  price     Float
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

enum Role {
  USER
  EXPORTER
  IMPORTER
  ADMIN
}

enum ProductCategory {
  CHEMICALS
  MACHINES
  TEXTILES
  MEDICAL
  HANDICRAFTS
  FOOD
  ELECTRONICS
  AUTOMOTIVE
  CONSTRUCTION
  AGRICULTURE
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum ShipmentStatus {
  PREPARING
  IN_TRANSIT
  CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
  RETURNED
}

enum DocumentType {
  BUSINESS_LICENSE
  TAX_CERTIFICATE
  IMPORT_EXPORT_LICENSE
  CERTIFICATE_OF_ORIGIN
  QUALITY_CERTIFICATE
  INSURANCE_DOCUMENT
  INVOICE
  PACKING_LIST
  BILL_OF_LADING
  OTHER
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_UPDATE
  MESSAGE_RECEIVED
  PAYMENT_RECEIVED
  DOCUMENT_VERIFIED
  ACCOUNT_VERIFIED
  GENERAL
}
