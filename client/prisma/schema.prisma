generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String         @id @default(uuid())
  name                String?
  email               String         @unique
  password            String?
  role                Role           @default(IMPORTER)
  companyName         String?
  country             String?
  phone               String?
  website             String?
  businessType        String?
  taxId               String?
  address             String?
  verified            Boolean        @default(false)
  avatar              String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  businessHours       Json?          @default("{}")
  description         String?
  monthlyBudget       Float          @default(0)
  preferredCategories String[]       @default([])
  socialLinks         Json?          @default("{}")
  deletedAt           DateTime?
  documents           Document[]
  requestedCalls      CallSchedule[] @relation("CallRequester")
  receivedCalls       CallSchedule[] @relation("CallReceiver")
  outgoingSessions    CallSession[]  @relation("CallCaller")
  incomingSessions    CallSession[]  @relation("CallCallee")
  receivedMessages    Message[]      @relation("Receiver")
  sentMessages        Message[]      @relation("Sender")
  notifications       Notification[]
  orders              Order[]        @relation("ImporterOrders")
  exportedProducts    Product[]      @relation("ExporterProducts")
  shipments           Shipment[]
  suppliers           Supplier[]
  wishlist            Wishlist[]

  @@map("users")
}

model Product {
  id               String         @id @default(uuid())
  exporterId       String
  name             String
  description      String
  price            Float
  minOrderQty      Int
  unit             String
  originCountry    String
  hsCode           String?
  images           String[]
  certifications   String[]
  available        Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  quantity         Int            @default(0)
  trustDocumentUrl String?
  category         String
  deletedAt        DateTime?
  orders           Order[]        @relation("ProductToOrder")
  priceHistory     PriceHistory[]
  exporter         User           @relation("ExporterProducts", fields: [exporterId], references: [id], onDelete: Cascade)
  wishlistedBy     Wishlist[]

  @@map("products")
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  importerId    String
  totalPrice    Float
  currency      String        @default("USD")
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  productId     String
  quantity      Int
  messages      Message[]
  importer      User          @relation("ImporterOrders", fields: [importerId], references: [id])
  product       Product       @relation("ProductToOrder", fields: [productId], references: [id])
  shipment      Shipment?

  @@map("orders")
}

model Shipment {
  id                String         @id @default(uuid())
  orderId           String         @unique
  userId            String
  trackingNumber    String         @unique
  carrier           String
  origin            String
  destination       String
  estimatedDelivery DateTime
  actualDelivery    DateTime?
  status            ShipmentStatus @default(PREPARING)
  currentLocation   String?
  statusHistory     Json[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id])
  user              User           @relation(fields: [userId], references: [id])

  @@map("shipments")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  orderId    String?
  subject    String?
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  order      Order?   @relation(fields: [orderId], references: [id])
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
  sender     User     @relation("Sender", fields: [senderId], references: [id])

  @@map("messages")
}

model CallSchedule {
  id              String           @id @default(uuid())
  requesterId     String
  receiverId      String
  title           String?
  agenda          String?
  callType        CallType         @default(VIDEO)
  scheduledFor    DateTime
  durationMinutes Int              @default(30)
  timezone        String           @default("UTC")
  status          CallScheduleStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  requester       User             @relation("CallRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver        User             @relation("CallReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sessions        CallSession[]

  @@index([requesterId, status, scheduledFor])
  @@index([receiverId, status, scheduledFor])
  @@map("call_schedules")
}

model CallSession {
  id            String            @id @default(uuid())
  scheduleId    String?
  callerId      String
  calleeId      String
  callType      CallType          @default(VIDEO)
  status        CallSessionStatus @default(RINGING)
  startedAt     DateTime          @default(now())
  connectedAt   DateTime?
  endedAt       DateTime?
  durationSec   Int?
  endedReason   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  schedule      CallSchedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  caller        User              @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee        User              @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([status, createdAt])
  @@map("call_sessions")
}

model Document {
  id          String       @id @default(uuid())
  ownerId     String
  type        DocumentType
  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  verified    Boolean      @default(false)
  verifiedAt  DateTime?
  verifiedBy  String?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation(fields: [ownerId], references: [id])

  @@map("documents")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Supplier {
  id            String   @id @default(uuid())
  userId        String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  country       String?
  category      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("suppliers")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String
  price     Float
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

enum Role {
  USER
  EXPORTER
  IMPORTER
  ADMIN
}

enum ProductCategory {
  CHEMICALS
  MACHINES
  TEXTILES
  MEDICAL
  HANDICRAFTS
  FOOD
  ELECTRONICS
  AUTOMOTIVE
  CONSTRUCTION
  AGRICULTURE
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum ShipmentStatus {
  PREPARING
  IN_TRANSIT
  CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
  RETURNED
}

enum DocumentType {
  BUSINESS_LICENSE
  TAX_CERTIFICATE
  IMPORT_EXPORT_LICENSE
  CERTIFICATE_OF_ORIGIN
  QUALITY_CERTIFICATE
  INSURANCE_DOCUMENT
  INVOICE
  PACKING_LIST
  BILL_OF_LADING
  OTHER
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  MESSAGE_RECEIVED
  CALL_SCHEDULED
  CALL_ACCEPTED
  CALL_REJECTED
  CALL_REMINDER
  MISSED_CALL
  PAYMENT_RECEIVED
  DOCUMENT_VERIFIED
  ACCOUNT_VERIFIED
  GENERAL
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallScheduleStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum CallSessionStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
  FAILED
}
